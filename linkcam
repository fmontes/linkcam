#!/usr/bin/env bash
#
# linkcam — instantly recenter the Insta360 Link 2 gimbal (and more)
#
# The Link 2's gimbal is controlled via standard UVC PanTilt Absolute.
# macOS won't let libusb claim the camera interface, so we drive it through
# IOKit using uvc-util (bundled alongside this script).
#
# Usage:
#   linkcam                  # center the gimbal (pan=0, tilt=0)  [default]
#   linkcam status           # show pan/tilt, zoom, and ai-tracking state
#   linkcam ai [on|off]      # toggle (or set) AI subject tracking
#   linkcam zoom <n>         # set zoom (1x .. 4x, e.g. "1.5" or "1.5x")
#   linkcam pan <deg>        # set pan only, in degrees (tilt unchanged)
#   linkcam tilt <deg>       # set tilt only, in degrees (pan unchanged)
#   linkcam set <pan> <tilt> # set both, in degrees
#
# Pan/tilt take DEGREES (e.g. "30", "-12.5"). Suffix "u" for raw 1/3600-deg
# units. The gimbal only moves in 1-degree steps and its real travel is
# pan +/-145, tilt -90..+100; values are snapped and clamped to fit.
#
# Zoom takes a MULTIPLIER from 1 to 4 ("1.5", "1.5x"); raw control values
# (100..400, where 100 = 1x) are accepted too and clamped to the range.
#
set -euo pipefail

# Resolve the real script location even when invoked through a symlink,
# so the bundled uvc-util sitting next to it is always found.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
# The compiled helpers live in bin/ next to this script (repo layout), but
# also accept them sitting directly alongside it (e.g. a flat install).
if [ -x "$SCRIPT_DIR/bin/uvc-util" ]; then
    HELPER_DIR="$SCRIPT_DIR/bin"
else
    HELPER_DIR="$SCRIPT_DIR"
fi
UVC="$HELPER_DIR/uvc-util"
XU="$HELPER_DIR/xu-probe"     # raw vendor Extension Unit access (AI tracking)

# Insta360 Link 2 — matched by USB vendor:product so the device index
# doesn't matter (other cameras can come and go).
VENDOR_PRODUCT="0x2e1a:0x4c04"
SEL=(-V "$VENDOR_PRODUCT")

# AI tracking is a vendor XU control (reverse-engineered): writing 01/00 to
# unit 11, selector 0x02 turns the Link 2's subject tracking on/off.
AI_UNIT=11
AI_SEL=0x02

die() { echo "linkcam: $*" >&2; exit 1; }

[ -x "$UVC" ] || die "uvc-util not found at $UVC"
[ -x "$XU" ]  || die "xu-probe not found at $XU"

# Fail clearly if the camera isn't plugged in.
if ! "$UVC" -c >/dev/null 2>&1 || ! "$UVC" "${SEL[@]}" -o pan-tilt-abs >/dev/null 2>&1; then
    die "Insta360 Link 2 not found. Is it plugged in and awake?"
fi

get_pt() { "$UVC" "${SEL[@]}" -o pan-tilt-abs 2>/dev/null; }
get_num() { echo "$1" | sed -E "s/.*$2=(-?[0-9]+).*/\1/"; }

# The gimbal works in 1/3600-degree units and only accepts multiples of the
# 3600 step size — a write of 1000 quantizes to 0 and looks like nothing
# happened. The descriptor advertises +/-648000 but the gimbal physically
# stops well short of that and silently clamps, so we use the measured range.
STEP=3600
PAN_MIN=-522000   PAN_MAX=522000     # +/-145 degrees
TILT_MIN=-324000  TILT_MAX=360000    # -90 .. +100 degrees

# Zoom is a plain unsigned value where 100 = 1x, up to 400 = 4x.
ZOOM_MIN=100  ZOOM_MAX=400

# Accept either degrees ("30", "-12.5", "30deg") or raw units ("108000u").
# Returns raw units snapped to the step size and clamped to the real range.
to_units() {
    local raw="$1" min="$2" max="$3" val
    case "$raw" in
        *u|*U)          val="${raw%[uU]}" ;;                       # raw units
        *deg|*d)        val="$(deg_to_units "${raw%%[dD]*}")" ;;    # explicit degrees
        *)              val="$(deg_to_units "$raw")" ;;            # bare = degrees
    esac
    [ -n "$val" ] || die "not a number: $raw"
    # snap to nearest multiple of STEP (round-half-away-from-zero)
    val="$(awk -v v="$val" -v s="$STEP" \
        'BEGIN{ printf "%d", (v<0 ? -1 : 1) * int((v<0?-v:v)/s + 0.5) * s }')"
    (( val < min )) && val="$min"
    (( val > max )) && val="$max"
    echo "$val"
}

# Prints units on success, nothing on bad input (caller reports the error).
deg_to_units() {
    awk -v d="$1" 'BEGIN{ if (d+0 != d && d != "0") exit 1; printf "%d", d * 3600 }' 2>/dev/null
}

units_to_deg() { awk -v u="$1" 'BEGIN{ printf "%.1f", u / 3600 }'; }

# Prints the number back on success, nothing on bad input.
as_num() { awk -v v="$1" 'BEGIN{ if (v+0 != v && v != "0") exit 1; print v+0 }' 2>/dev/null; }

# Accept a multiplier ("1.5", "1.5x") or a raw control value ("150"). The two
# ranges don't overlap -- raw starts at 100 -- so a bare number is unambiguous.
# uvc-util silently writes the MAXIMUM for anything it can't parse (a bare
# "1.1" lands on 4x), so the value is resolved and clamped here instead.
to_zoom() {
    local raw="$1" forced_mult=0 val
    case "$raw" in
        *x|*X) raw="${raw%[xX]}"; forced_mult=1 ;;
    esac
    val="$(as_num "$raw")"
    [ -n "$val" ] || die "not a number: $1"
    if [ "$forced_mult" = 1 ] || awk -v v="$val" 'BEGIN{ exit !(v < 100) }'; then
        val="$(awk -v v="$val" 'BEGIN{ printf "%d", v * 100 + 0.5 }')"
    else
        val="$(awk -v v="$val" 'BEGIN{ printf "%d", v + 0.5 }')"
    fi
    (( val < ZOOM_MIN )) && val=$ZOOM_MIN
    (( val > ZOOM_MAX )) && val=$ZOOM_MAX
    echo "$val"
}

# 100 -> "1", 150 -> "1.5" (trailing zeros trimmed).
zoom_to_x() { awk -v z="$1" 'BEGIN{ s = sprintf("%.2f", z / 100); sub(/\.?0+$/, "", s); print s }'; }

# Read the AI-tracking enable byte (00 = off, 01 = on).
ai_state() {
    "$XU" -V "$VENDOR_PRODUCT" get "$AI_UNIT" "$AI_SEL" 1 2>/dev/null \
        | tail -1 | tr -d ' '
}
ai_set() { "$XU" -V "$VENDOR_PRODUCT" set "$AI_UNIT" "$AI_SEL" "$1" >/dev/null 2>&1; }

cmd="${1:-center}"

case "$cmd" in
  center|"")
    "$UVC" "${SEL[@]}" -s pan-tilt-abs="default" >/dev/null
    echo "✓ recentered (pan=0, tilt=0)"
    ;;
  status)
    pt="$(get_pt)"
    zoom="$("$UVC" "${SEL[@]}" -o zoom-abs 2>/dev/null || echo '?')"
    case "$(ai_state)" in 01) ai="on" ;; 00) ai="off" ;; *) ai="?" ;; esac
    echo "pan:         $(units_to_deg "$(get_num "$pt" pan)")°"
    echo "tilt:        $(units_to_deg "$(get_num "$pt" tilt)")°"
    echo "raw:         $pt"
    echo "zoom:        $(zoom_to_x "$zoom")x ($zoom)"
    echo "ai tracking: $ai"
    ;;
  ai)
    want="${2:-toggle}"
    case "$want" in
      on)  ai_set 01; echo "✓ ai tracking ON" ;;
      off) ai_set 00; echo "✓ ai tracking OFF" ;;
      toggle)
        case "$(ai_state)" in
          01) ai_set 00; echo "✓ ai tracking OFF" ;;
          00) ai_set 01; echo "✓ ai tracking ON" ;;
          *)  die "couldn't read AI tracking state" ;;
        esac ;;
      status)
        case "$(ai_state)" in 01) echo "ai tracking: on" ;; 00) echo "ai tracking: off" ;; *) echo "ai tracking: ?" ;; esac ;;
      *) die "usage: linkcam ai [on|off|toggle|status]" ;;
    esac
    ;;
  zoom)
    [ $# -ge 2 ] || die "usage: linkcam zoom <multiplier>   (1 .. 4, e.g. 1.5)"
    z="$(to_zoom "$2")"
    "$UVC" "${SEL[@]}" -s zoom-abs="$z" >/dev/null
    echo "✓ zoom=$(zoom_to_x "$z")x ($z)"
    ;;
  pan)
    [ $# -ge 2 ] || die "usage: linkcam pan <degrees>"
    cur="$(get_pt)"; tilt="$(get_num "$cur" tilt)"
    pan="$(to_units "$2" "$PAN_MIN" "$PAN_MAX")"
    "$UVC" "${SEL[@]}" -s pan-tilt-abs="{pan=$pan,tilt=$tilt}" >/dev/null
    echo "✓ pan=$(units_to_deg "$pan")° (tilt=$(units_to_deg "$tilt")°)"
    ;;
  tilt)
    [ $# -ge 2 ] || die "usage: linkcam tilt <degrees>"
    cur="$(get_pt)"; pan="$(get_num "$cur" pan)"
    tilt="$(to_units "$2" "$TILT_MIN" "$TILT_MAX")"
    "$UVC" "${SEL[@]}" -s pan-tilt-abs="{pan=$pan,tilt=$tilt}" >/dev/null
    echo "✓ tilt=$(units_to_deg "$tilt")° (pan=$(units_to_deg "$pan")°)"
    ;;
  set)
    [ $# -ge 3 ] || die "usage: linkcam set <pan-degrees> <tilt-degrees>"
    pan="$(to_units "$2" "$PAN_MIN" "$PAN_MAX")"
    tilt="$(to_units "$3" "$TILT_MIN" "$TILT_MAX")"
    "$UVC" "${SEL[@]}" -s pan-tilt-abs="{pan=$pan,tilt=$tilt}" >/dev/null
    echo "✓ pan=$(units_to_deg "$pan")°, tilt=$(units_to_deg "$tilt")°"
    ;;
  -h|--help|help)
    sed -n '3,23p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    die "unknown command '$cmd' (try: center, status, ai, zoom, pan, tilt, set)"
    ;;
esac
